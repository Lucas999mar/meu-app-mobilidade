# ============================================================
# Mobilidade Regional — Variáveis de Ambiente
# ============================================================
# Copie para .env.local e preencha os valores

# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mobilidade_regional
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=sua-chave-secreta-troque-em-producao

# Redis (Etapa 2+)
# REDIS_URL=redis://localhost:6379

# Google Maps (Etapa 3+)
# GOOGLE_MAPS_API_KEY=

# Pagamentos (Etapa 5+)
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=

# Push Notifications (Etapa 3+)
# FCM_SERVER_KEY=
